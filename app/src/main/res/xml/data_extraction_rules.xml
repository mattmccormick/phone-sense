<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Room auto-close checkpoints the WAL before backup. Android excludes cache directories. -->
        <include domain="database" path="." />
        <include domain="file" path="datastore/settings.preferences_pb" />

        <exclude domain="database" path="androidx.work.workdb" />
        <exclude domain="database" path="androidx.work.workdb-shm" />
        <exclude domain="database" path="androidx.work.workdb-wal" />
    </cloud-backup>
    <device-transfer>
        <!-- Room auto-close checkpoints the WAL before transfer. Android excludes cache directories. -->
        <include domain="database" path="." />
        <include domain="file" path="datastore/settings.preferences_pb" />

        <exclude domain="database" path="androidx.work.workdb" />
        <exclude domain="database" path="androidx.work.workdb-shm" />
        <exclude domain="database" path="androidx.work.workdb-wal" />
    </device-transfer>
</data-extraction-rules>
