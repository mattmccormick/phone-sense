<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chart_widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="@string/chart_widget_heading" android:textColor="@color/widget_text"
            android:textSize="14sp" android:textStyle="bold" android:includeFontPadding="false" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/chart_widget_unit" android:textColor="@color/widget_secondary"
            android:textSize="10sp" android:includeFontPadding="false" />
    </LinearLayout>
    <ImageView android:id="@+id/chart_widget_image" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp"
        android:visibility="gone" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <TextView android:id="@+id/chart_widget_message" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:gravity="center"
        android:text="@string/chart_widget_loading" android:textColor="@color/widget_secondary" android:textSize="14sp" />
    <TextView android:id="@+id/chart_widget_note" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:visibility="gone" android:layout_marginTop="5dp" android:text="@string/chart_widget_note" android:textSize="9sp"
        android:textColor="@color/widget_secondary" android:includeFontPadding="false" />
</LinearLayout>
